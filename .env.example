# 外部 OpenAI-compatible 数据面配置（可使用独立 newAPI）
# 本文件是示例；后端本地 Docker 默认读取 server/.env。
# 核心 Compose 不提供隐式地址；加载 deploy/newapi Overlay 时才注入容器内 URL。
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=

# 客户端运行时外部管理链接；不嵌入、代理或探测 newAPI 管理界面。
NEWAPI_WEB_URL=http://localhost:3000

# 回退：直接访问 OpenRouter（向后兼容）
OPENROUTER_API_KEY=

# RAG 专用 Rerank。密钥仅保存在服务端；未配置时安全回退融合排序。
RERANK_API_URL=
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=
RAG_RERANK_LLM_MODEL=
RAG_RERANK_MAX_CANDIDATES=20
RAG_RERANK_MAX_INPUT_CHARS=24000
RAG_RERANK_TIMEOUT_SECONDS=5

# OpenRouter 兼容请求头（可选）
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=ModelMirror

# Agent Strategy V2。设为 false 并重启可立即恢复旧 ReAct-Lite 运行路径。
WORKFLOW_AGENT_STRATEGY_V2_ENABLED=true
# 独立工作流失败处置入口默认关闭；启用前先激活内部处理器并验证脱敏事件。
WORKFLOW_FAILURE_TRIGGERS_ENABLED=false
WORKFLOW_SUBWORKFLOWS_ENABLED=false
# 安全 HTTP V2 默认关闭；启用后仍仅允许固定公网目标和加密凭据。
WORKFLOW_HTTP_REQUESTS_ENABLED=false
WORKFLOW_NODE_RETRIES_ENABLED=false
WORKFLOW_MCP_TOOLS_ENABLED=false
WORKFLOW_FORMS_ENABLED=false
WORKFLOW_KNOWLEDGE_PROPOSALS_ENABLED=false
# RSS/Atom 订阅默认关闭；启用后仅轮询无需认证的公网 HTTPS Feed。
WORKFLOW_RSS_TRIGGERS_ENABLED=false
# IMAP 邮件入口默认关闭；启用后仅以只读 IMAPS 993 轮询固定 INBOX。
WORKFLOW_IMAP_TRIGGERS_ENABLED=false
WORKFLOW_FORMS_PUBLIC_BASE_URL=
EXPERT_TEAM_AGENCY_PLANNER_ENABLED=0
# 仅控制组队预览；Docker Compose 默认 450 秒，允许范围 30–600 秒。
EXPERT_TEAM_AGENCY_PLANNER_TIMEOUT_SECONDS=450
EXPERT_TEAM_AGENCY_EXECUTION_ENABLED=0
EXPERT_TEAM_AGENCY_REVISION_ENABLED=0
# 可选：本机直跑时覆盖可复用任务模板/固定阵容目录；Docker 默认复用持久化运行目录。
# EXPERT_TEAM_AGENCY_ASSET_DIR=./server/xpert_runtime/storage/expert_team_assets

# CORS（可选）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Legacy Dify 代理（可选；当前 /workflow 与 /rag 不依赖）
DIFY_API_BASE_URL=http://localhost:5001/v1
DIFY_API_KEY=your-dify-api-key

# OmniRoute Compose profile secrets. Generate independent random values and do
# not reuse the ModelMirror API key. Empty values intentionally fail secure.
OMNIROUTE_JWT_SECRET=replace-with-long-random-secret
OMNIROUTE_API_KEY_SECRET=replace-with-long-random-secret
OMNIROUTE_INITIAL_PASSWORD=replace-with-strong-local-password
OMNIROUTE_STORAGE_ENCRYPTION_KEY=replace-with-32-byte-random-secret
OMNIROUTE_WS_BRIDGE_SECRET=replace-with-long-random-secret

# ModelMirror adapter activation. Keep disabled until a restricted OmniRoute
# API key has been created in the local console.
OMNIROUTE_ENABLED=false
OMNIROUTE_API_KEY=
MODEL_ROUTER_DEFAULT=newapi
OMNIROUTE_BUDGET_HEADERS_ENABLED=false

# 原生智能调度灰度由设置页持久化。仅在紧急回退时取消下一行注释；
# 显式 sidecar 会覆盖数据库中的运行方式，删除或留空后恢复设置页策略。
# MODEL_ROUTER_ENGINE=sidecar
# 原生算法紧急回退：legacy 只回退评分/选择；sidecar 回退完整执行引擎。
MODEL_ROUTER_NATIVE_ALGORITHM=omniroute-parity-v2
MODEL_ROUTER_CANARY_PERCENT=0
MODELMIRROR_DEFAULT_TENANT_ID=local
MODELMIRROR_DEFAULT_OWNER_ID=local
MCP_HUB_ENABLED=false
MCP_HUB_REMOTE_ENABLED=false
MCP_HUB_REVIEW_FACTORY_ENABLED=false
MCP_HUB_LOCAL_CONTRACT_PUBLISH_ENABLED=false
MCP_HUB_CONTRACT_SIGNING_KEY=
MCP_HUB_TRUSTED_CHANNEL_ENABLED=false
MCP_HUB_AUTO_REVIEW_ENABLED=false
# 远程认证 R0-R1 默认关闭；仅确认本地单主体边界并强制外部主密钥后才可启用。
MCP_REMOTE_AUTH_ENABLED=false
MCP_REMOTE_STATIC_TOKEN_ENABLED=false
MCP_REMOTE_AUTH_LOCAL_SINGLE_OWNER_ACK=false
# OAuth R2A 发现与登记、R2B 授权与加密 Token revision 均默认关闭。
MCP_REMOTE_OAUTH_ENABLED=false
MCP_REMOTE_OAUTH_AUTHORIZATION_ENABLED=false
MCP_REMOTE_OAUTH_TOKEN_STORAGE_ENABLED=false
# R3A 复核与 R3B Runtime/远程撤销开关彼此独立，且默认关闭。
MCP_REMOTE_OAUTH_REVIEW_ENABLED=false
MCP_REMOTE_OAUTH_RUNTIME_ENABLED=false
# RFC 7009 远程撤销不可逆；未开启时 DELETE 仅完成本地撤销。
MCP_REMOTE_OAUTH_REMOTE_REVOCATION_ENABLED=false
# DCR 是外部写操作且规范已建议优先使用 Client ID Metadata Documents，默认关闭。
MCP_REMOTE_OAUTH_DYNAMIC_REGISTRATION_ENABLED=false
MCP_REMOTE_OAUTH_CLIENT_METADATA_URL=
MCP_REMOTE_OAUTH_REDIRECT_URI=
MCP_REMOTE_REVIEW_UNIFICATION_ENABLED=false
MCP_REMOTE_CATALOG_OAUTH_ENABLED=false
MCP_REMOTE_CONTRACT_RUNTIME_ENABLED=false
MCP_REMOTE_CATALOG_RUNTIME_ENABLED=false
MCP_LEGACY_UNRESTRICTED_CONNECT_ENABLED=false
# 至少 32 字符；不要提交真实值。缺失时只锁定 Provider 管理面。
MODEL_MIRROR_PROVIDER_ADMIN_PAIRING_SECRET=
# 动态内网 Provider 仅接受精确 host:port，逗号分隔；不支持通配符或 CIDR。
MODEL_MIRROR_PROVIDER_INTERNAL_ALLOWLIST=
# 仅控制显式、可能计费的 newAPI 文本 Chat 认证；不影响连接管理或数据面。
MODEL_MIRROR_PROVIDER_CHAT_CERTIFICATION_ENABLED=true
# 认证默认 24 小时过期；允许范围 300-2592000 秒，非法配置会失败关闭 Canary。
MODEL_MIRROR_PROVIDER_CHAT_CERTIFICATION_MAX_AGE_SECONDS=86400
# 仅控制用户显式会话 Canary；默认关闭，不改变当前默认数据面。
MODEL_MIRROR_PROVIDER_CHAT_CANARY_ENABLED=false
# R5 Managed Chat 部署总开关。默认关闭；R5B 仅接管 preferred 白名单普通文本。
MODEL_CONTROL_CHAT_ENABLED=false
# R6 Agent/Workflow Managed Provider data-plane switches. All remain off in R6A;
# policy and exact bindings alone never activate an entry.
MODEL_CONTROL_AGENT_SHADOW_ENABLED=false
MODEL_CONTROL_META_AGENT_ENABLED=false
MODEL_CONTROL_WORKFLOW_LLM_ENABLED=false
MODEL_CONTROL_WORKFLOW_AGENT_ENABLED=false
MODEL_CONTROL_WORKFLOW_DEPLOYMENT_ENABLED=false
MODEL_CONTROL_XPERT_ENABLED=false
MODEL_CONTROL_XPERT_APP_ENABLED=false
MODEL_CONTROL_EXPERT_TEAM_PLANNER_ENABLED=false
MODEL_CONTROL_EXPERT_TEAM_DAG_ENABLED=false
MODEL_CONTROL_FUSION_ENABLED=false
MODEL_CONTROL_ROUTE_AGENT_ENABLED=false
MODEL_CONTROL_TEAM_CHAT_ENABLED=false
# R8 Multimodal Provider control-plane switches. R8A only exposes policy,
# Adapter and qualification foundations; every data-plane switch stays off.
MODEL_CONTROL_CHAT_IMAGE_ENABLED=false
MODEL_CONTROL_CHAT_DOCUMENT_ENABLED=false
MODEL_CONTROL_RAG_VISION_ENABLED=false
MODEL_CONTROL_WORKFLOW_VISION_ENABLED=false
MODEL_CONTROL_WORKFLOW_VISION_DEPLOYMENT_ENABLED=false
MODEL_CONTROL_XPERT_VISION_ENABLED=false
MODEL_CONTROL_IMAGE_GENERATION_ENABLED=false
MODEL_CONTROL_TRANSCRIPTION_ENABLED=false
MODEL_CONTROL_SPEECH_ENABLED=false
MODEL_CONTROL_XPERT_AUDIO_ENABLED=false
MODEL_CONTROL_CHAT_AUDIO_ENABLED=false
MODEL_CONTROL_AUDIO_GENERATION_ENABLED=false
MODEL_CONTROL_VIDEO_ANALYSIS_ENABLED=false
MODEL_CONTROL_CHAT_VIDEO_ENABLED=false
MODEL_CONTROL_VIDEO_GENERATION_ENABLED=false
MODEL_CONTROL_REALTIME_VOICE_ENABLED=false
# 生产环境外部注入规范主密钥；Remote Auth 要求同时开启强制模式，
# 且不会使用密钥与密文同卷的兼容回退。不要提交真实值。
MODEL_MIRROR_CREDENTIAL_MASTER_KEY=
MODEL_MIRROR_REQUIRE_EXTERNAL_CREDENTIAL_MASTER_KEY=false
# 旧变量仅供迁移期读取：MODEL_ROUTER_CREDENTIAL_MASTER_KEY=
# 仅限灾备或已完成独立审计的运维覆盖。普通设置界面仍执行 14 天/500 次门禁。
MODEL_ROUTER_ALLOW_NATIVE_OVERRIDE=false

# Optional: keep persistent bind-mounted data in a stable directory while
# building source from another Git worktree.
MODELMIRROR_DATA_ROOT=.

# Coding uses an independently managed provider network and never joins the
# Model Provider Control Plane/newAPI network.
CODING_PROVIDER_NETWORK_NAME=modelmirror-coding-provider

# File asset migration mode: legacy keeps existing module stores authoritative;
# shadow adds non-authoritative indexing; native is reserved for a later gate.
FILE_ASSET_STORE_MODE=legacy
FILE_ASSET_STORAGE_DIR=/app/file_assets/storage
CHAT_FILE_INPUT_ENABLED=false
CHAT_ONE_SHOT_VISION_ENABLED=false
CHAT_OPENROUTER_OCR_ENABLED=false
WORKFLOW_FILE_ASSETS_ENABLED=false
FILE_OUTPUT_ASSETS_ENABLED=false
CHAT_FILE_OUTPUT_TOOL_ENABLED=false

# Native General Agent workspace. Docker Compose stores its data in a named
# volume at /data/agent-workspace; set false to hide the UI and disable APIs.
AGENT_WORKSPACE_ENABLED=true

# Upstream Penguin Core shadow engine. Disabled by default: this produces only
# isolated, unverified candidates and never creates App, Version, Artifact,
# browser evidence, preview, or publication records.
AGENT_APP_ENGINE_SHADOW_ENABLED=false

# Optional controlled local projects. Keep disabled unless the projects overlay
# is loaded. The root must be an absolute directory containing
# .modelmirror-coding-projects.json; do not point it at a broad user directory.
CODING_PROJECTS_ENABLED=false
CODING_PROJECTS_ROOT=
