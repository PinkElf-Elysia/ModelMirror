# Local environment and secret material
.env
.env.*
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/credentials.json

# Runtime databases and file-backed state
**/*.db
**/*.sqlite
**/*.sqlite3
**/storage
**/storage/**
**/uploads
**/uploads/**
skills/installed
skills/installed/**
skills/tmp
skills/tmp/**
mcp/installed
mcp/installed/**
mcp/sandboxes
mcp/sandboxes/**
workflow_sandboxes
workflow_sandboxes/**
coding-recovery
coding-recovery/**
office_host/certs
office_host/certs/**

# Caches and local logs
**/__pycache__
**/__pycache__/**
**/.pytest_cache
**/.pytest_cache/**
**/*.pyc
**/*.pyo
**/*.log
**/*.err

# The upstream engine is always installed and built from its pinned lockfile
# inside the dedicated Node 24 image stage. Never import host pnpm state.
agent_upstream/node_modules
agent_upstream/node_modules/**
agent_upstream/.pnpm-store
agent_upstream/.pnpm-store/**
agent_upstream/build
agent_upstream/build/**
agent_upstream/vendor/penguin_harness/packages/*/dist
agent_upstream/vendor/penguin_harness/packages/*/dist/**
agent_upstream/vendor/penguin_harness/packages/*/node_modules
agent_upstream/vendor/penguin_harness/packages/*/node_modules/**
