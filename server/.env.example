# 推荐：newAPI 或其他 OpenAI-compatible 网关。
# Docker Compose 会覆盖 URL 为 http://new-api:3000/v1/chat/completions。
LLM_GATEWAY_URL=http://localhost:3000/v1/chat/completions
LLM_GATEWAY_KEY=your-new-api-key

# 回退与首期多模态能力。
OPENROUTER_API_KEY=sk-or-v1-your-key-here
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=ModelMirror
# 可选运维覆盖；实时目录和前端默认选择不依赖这两个旧回退值。
OPENROUTER_TEXT_FALLBACK_MODEL=deepseek/deepseek-chat
OPENROUTER_VISION_FALLBACK_MODEL=qwen/qwen2.5-vl-72b-instruct

# 视频能力默认关闭；完成模型与费用验收后再按需启用。
MULTIMODAL_VIDEO_ANALYSIS_ENABLED=false
MULTIMODAL_VIDEO_GENERATION_ENABLED=false

# OmniRoute optional sidecar. Keep disabled until the profile is healthy and a
# dedicated execution/catalog-only API key has been created in OmniRoute.
OMNIROUTE_ENABLED=false
OMNIROUTE_BASE_URL=http://omniroute:20128
OMNIROUTE_API_KEY=replace-with-dedicated-omniroute-key
MODEL_ROUTER_DEFAULT=newapi
MODEL_ROUTER_ENGINE=
MODEL_ROUTER_CANARY_PERCENT=0
MODEL_ROUTER_TENANT_ID=local
MODEL_ROUTER_ALLOW_NATIVE_OVERRIDE=false
OMNIROUTE_CATALOG_TTL_SECONDS=30
OMNIROUTE_STALE_TTL_SECONDS=600
OMNIROUTE_REQUEST_TIMEOUT_SECONDS=12
OMNIROUTE_BUDGET_HEADERS_ENABLED=false

# Legacy Dify compatibility only; /workflow and /rag do not depend on it.
DIFY_API_BASE_URL=http://localhost:5001/v1
DIFY_API_KEY=app-your-dify-api-key
