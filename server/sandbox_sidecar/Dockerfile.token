FROM node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS node_packages

WORKDIR /opt/modelmirror
COPY token_runtime/package.json token_runtime/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46 AS brave_packages

WORKDIR /opt/modelmirror/brave
COPY brave_runtime/package.json brave_runtime/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM python:3.12-slim@sha256:401f6e1a67dad31a1bd78e9ad22d0ee0a3b52154e6bd30e90be696bb6a3d7461

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_TOKEN_SOCKET_PATH=/run/modelmirror-token-mcp/token-mcp.sock \
    MCP_TOKEN_WORKSPACE_ROOT=/workspaces

COPY --from=node_packages /usr/local/bin/node /usr/local/bin/node
COPY --from=node_packages /opt/modelmirror/node_modules /opt/modelmirror/node_modules
COPY --from=brave_packages /opt/modelmirror/brave/node_modules /opt/modelmirror/brave/node_modules

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 sandbox \
    && useradd --uid 65532 --gid 65532 --home-dir /workspaces --no-create-home sandbox \
    && mkdir -p /opt/modelmirror/sandbox_sidecar /workspaces /run/modelmirror-token-mcp \
    && chown -R sandbox:sandbox /workspaces /run/modelmirror-token-mcp

WORKDIR /opt/modelmirror
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --retries 5 --timeout 120 -r requirements.txt
COPY __init__.py engine.py landlock_exec.py network_guard.cjs safe_http.py smoke_token_adapters.py smoke_token_gateway.py token_builtin.py token_contracts.py token_server.py ./sandbox_sidecar/
COPY THIRD_PARTY_NOTICES.md /usr/share/doc/modelmirror-mcp-token/THIRD_PARTY_NOTICES.md

USER 65532:65532
CMD ["python", "-m", "sandbox_sidecar.token_server"]
