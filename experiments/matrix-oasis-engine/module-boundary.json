{
  "schemaVersion": 1,
  "moduleId": "matrix-oasis-engine",
  "moduleRoot": ".",
  "moduleRootResolution": "directory-containing-module-boundary",
  "parentRepositoryPrefix": "experiments/matrix-oasis-engine/",
  "parentIntegration": "none",
  "allowedParentInteractions": [],
  "networkPolicy": {
    "creatorSource": "none",
    "verificationScripts": "loopback-only"
  },
  "forbiddenParentRoots": [
    "client",
    "server",
    ".github",
    "docker-compose.yml",
    "Dockerfile",
    "node_modules"
  ],
  "dependencyPolicy": {
    "moduleLocalWorkspacesOnly": true,
    "forbidExternalFileLinks": true,
    "forbiddenExternalProtocols": [
      "file:",
      "link:"
    ]
  },
  "pathPolicy": {
    "forbidExternalSymlinks": true,
    "forbidAbsolutePaths": true,
    "forbidParentTraversal": true,
    "forbidResolvedPathsOutsideModule": true
  },
  "forbiddenParentResources": [
    "source",
    "environment-variables",
    "database",
    "docker",
    "routes",
    "assets",
    "build-output"
  ],
  "toolchain": {
    "requiredForR0": {
      "node": "24.x",
      "npm": "11.x",
      "git": "available"
    },
    "optionalForFutureRounds": {
      "godot": "4.6.x"
    }
  },
  "generatedPaths": [
    "node_modules",
    "dist",
    "coverage",
    ".vite",
    ".godot",
    "exports"
  ],
  "forbiddenTrackedFileNames": [
    ".env",
    ".env.local",
    ".env.development",
    ".env.production"
  ],
  "forbiddenTrackedExtensions": [
    ".log",
    ".pem",
    ".key",
    ".p12",
    ".pfx"
  ],
  "licensePolicy": {
    "moduleLicense": "UNLICENSED",
    "allowedDependencyLicenses": [
      "MIT",
      "Apache-2.0",
      "BSD-2-Clause",
      "BSD-3-Clause",
      "ISC"
    ],
    "approvedDependencyLicenseExceptions": [
      {
        "package": "caniuse-lite",
        "version": "1.0.30001807",
        "license": "CC-BY-4.0",
        "scope": "transitive-development-dependency",
        "approvedOn": "2026-08-06",
        "approvalRecord": "user-approved-during-r0",
        "compliance": "Retain upstream attribution and license notice when distributing dependency materials."
      }
    ],
    "otherLicensesRequireHumanApproval": true
  }
}
