{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:matrix-oasis:runtime-game-pack:0.1.0",
  "title": "Matrix Oasis Runtime Game Pack 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "canonicalization",
    "source",
    "language",
    "title",
    "summary",
    "entryNodeIndex",
    "entities",
    "variables",
    "cues",
    "nodes",
    "endings"
  ],
  "properties": {
    "format": { "type": "string", "const": "matrix-oasis.runtime-game-pack" },
    "formatVersion": { "type": "string", "const": "0.1.0" },
    "canonicalization": { "type": "string", "const": "matrix-oasis.canonical-json/1" },
    "source": { "$ref": "#/$defs/source" },
    "language": { "$ref": "#/$defs/language" },
    "title": { "$ref": "#/$defs/prose" },
    "summary": { "$ref": "#/$defs/nullableProse" },
    "entryNodeIndex": { "$ref": "#/$defs/index" },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
    "cues": { "type": "array", "items": { "$ref": "#/$defs/cue" } },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/node" }
    },
    "endings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ending" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S"
    },
    "language": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "prose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "nullableProse": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/prose" }
      ]
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonZeroSafeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scalarValue": {
      "oneOf": [
        { "type": "boolean" },
        { "$ref": "#/$defs/safeInteger" },
        { "$ref": "#/$defs/id" }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "formatVersion", "id", "contentVersion", "canonicalSha256"],
      "properties": {
        "format": { "type": "string", "const": "matrix-oasis.authoring-game-pack" },
        "formatVersion": { "type": "string", "const": "0.1.0" },
        "id": { "$ref": "#/$defs/id" },
        "contentVersion": { "$ref": "#/$defs/contentVersion" },
        "canonicalSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/prose" },
        "description": { "$ref": "#/$defs/nullableProse" }
      }
    },
    "booleanVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "initial"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "const": "boolean" },
        "initial": { "type": "boolean" }
      }
    },
    "integerVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "initial"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "const": "integer" },
        "initial": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "enumVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "allowedValues", "initial"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "const": "enum" },
        "allowedValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "initial": { "$ref": "#/$defs/id" }
      }
    },
    "variable": {
      "oneOf": [
        { "$ref": "#/$defs/booleanVariable" },
        { "$ref": "#/$defs/integerVariable" },
        { "$ref": "#/$defs/enumVariable" }
      ]
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "channel", "intent"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "channel": { "type": "string", "enum": ["visual", "audio", "ui"] },
        "intent": { "$ref": "#/$defs/prose" }
      }
    },
    "indexList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/index" }
    },
    "allCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "conditions"],
      "properties": {
        "op": { "type": "string", "const": "all" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "anyCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "conditions"],
      "properties": {
        "op": { "type": "string", "const": "any" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "notCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "condition"],
      "properties": {
        "op": { "type": "string", "const": "not" },
        "condition": { "$ref": "#/$defs/condition" }
      }
    },
    "eqCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "variableIndex", "value"],
      "properties": {
        "op": { "type": "string", "const": "eq" },
        "variableIndex": { "$ref": "#/$defs/index" },
        "value": { "$ref": "#/$defs/scalarValue" }
      }
    },
    "neCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "variableIndex", "value"],
      "properties": {
        "op": { "type": "string", "const": "ne" },
        "variableIndex": { "$ref": "#/$defs/index" },
        "value": { "$ref": "#/$defs/scalarValue" }
      }
    },
    "ltCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "variableIndex", "value"],
      "properties": {
        "op": { "type": "string", "const": "lt" },
        "variableIndex": { "$ref": "#/$defs/index" },
        "value": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "lteCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "variableIndex", "value"],
      "properties": {
        "op": { "type": "string", "const": "lte" },
        "variableIndex": { "$ref": "#/$defs/index" },
        "value": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "gtCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "variableIndex", "value"],
      "properties": {
        "op": { "type": "string", "const": "gt" },
        "variableIndex": { "$ref": "#/$defs/index" },
        "value": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "gteCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "variableIndex", "value"],
      "properties": {
        "op": { "type": "string", "const": "gte" },
        "variableIndex": { "$ref": "#/$defs/index" },
        "value": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/allCondition" },
        { "$ref": "#/$defs/anyCondition" },
        { "$ref": "#/$defs/notCondition" },
        { "$ref": "#/$defs/eqCondition" },
        { "$ref": "#/$defs/neCondition" },
        { "$ref": "#/$defs/ltCondition" },
        { "$ref": "#/$defs/lteCondition" },
        { "$ref": "#/$defs/gtCondition" },
        { "$ref": "#/$defs/gteCondition" }
      ]
    },
    "setEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "variableIndex", "value"],
      "properties": {
        "op": { "type": "string", "const": "set" },
        "variableIndex": { "$ref": "#/$defs/index" },
        "value": { "$ref": "#/$defs/scalarValue" }
      }
    },
    "addEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "variableIndex", "value"],
      "properties": {
        "op": { "type": "string", "const": "add" },
        "variableIndex": { "$ref": "#/$defs/index" },
        "value": { "$ref": "#/$defs/nonZeroSafeInteger" }
      }
    },
    "emitCueEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "cueIndex"],
      "properties": {
        "op": { "type": "string", "const": "emitCue" },
        "cueIndex": { "$ref": "#/$defs/index" }
      }
    },
    "effect": {
      "oneOf": [
        { "$ref": "#/$defs/setEffect" },
        { "$ref": "#/$defs/addEffect" },
        { "$ref": "#/$defs/emitCueEffect" }
      ]
    },
    "nodeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index"],
      "properties": {
        "kind": { "type": "string", "const": "node" },
        "index": { "$ref": "#/$defs/index" }
      }
    },
    "endingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "index"],
      "properties": {
        "kind": { "type": "string", "const": "ending" },
        "index": { "$ref": "#/$defs/index" }
      }
    },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/nodeTarget" },
        { "$ref": "#/$defs/endingTarget" }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "entityIndexes", "when", "effects", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/prose" },
        "entityIndexes": { "$ref": "#/$defs/indexList" },
        "when": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/condition" }
          ]
        },
        "effects": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/effect" }
        },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "text", "entityIndexes", "entryCueIndexes", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/prose" },
        "text": { "$ref": "#/$defs/nullableProse" },
        "entityIndexes": { "$ref": "#/$defs/indexList" },
        "entryCueIndexes": { "$ref": "#/$defs/indexList" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "ending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "text", "cueIndexes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/prose" },
        "text": { "$ref": "#/$defs/nullableProse" },
        "cueIndexes": { "$ref": "#/$defs/indexList" }
      }
    }
  }
}
