        "rankLabel": "E",
        "worldRefs": ["world.reverend-insanity"],
        "sourceRefs": ["source.synthetic-player-card"]
      }
    ],
    "talents": [
      {
        "id": "talent.sovereign-immortal-fetus-gu",
        "displayName": "至尊仙胎蛊",
        "description": "人祖传说中的蛊虫。一旦使用，你将获得至尊仙体，道痕互不排斥，可以兼修所有流派，且恢复力惊人，是魔尊幽魂的毕生杰作。",
        "tierLabel": "SSS",
        "worldRefs": ["world.reverend-insanity"],
        "sourceRefs": ["source.synthetic-player-card"]
      },
      {
        "id": "talent.perseverance",
        "displayName": "坚持",
        "description": "一种精神境界。哪怕失败一万次，哪怕举世皆敌，哪怕身死道消，你也绝不放弃心中的目标。这是魔尊的潜质。",
        "tierLabel": "SSS",
        "worldRefs": ["world.reverend-insanity"],
        "sourceRefs": ["source.synthetic-player-card"]
      },
      {
        "id": "talent.spring-autumn-cicada-rebirth",
        "displayName": "春秋蝉(重生)",
        "description": "红莲魔尊的本命蛊，宙道奇蛊。当你死亡时，它能带着你的意志逆流光阴长河，回到过去。这是逆天改命、知晓未来的终极外挂，但有失败风险。",
        "tierLabel": "SSS",
        "worldRefs": ["world.reverend-insanity"],
        "sourceRefs": ["source.synthetic-player-card"]
      },
      {
        "id": "talent.rank-nine-venerable-aptitude",
        "displayName": "九转尊者资质",
        "description": "你拥有成就九转蛊尊的潜力。你的才情、毅力和气运都是当世顶尖，注定要无敌于天下，打破宿命。",
        "tierLabel": "SSS",
        "worldRefs": ["world.reverend-insanity"],
        "sourceRefs": ["source.synthetic-player-card"]
      },
      {
        "id": "talent.system-core-root",
        "displayName": "系统核心权限·root",
        "description": "【唯一·位面级】你拿到了穿越系统自己都不该给你的权限：每个世界可以强制刷新一次系统商店（五件商品全部换成 S 级以上），并把一次读档复活改为「不掉落任何东西的原地复活」。系统会记住这次越权。",
        "tierLabel": "UR",
        "worldRefs": [],
