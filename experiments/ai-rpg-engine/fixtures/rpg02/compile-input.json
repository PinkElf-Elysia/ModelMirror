      "kind": "talent",
      "worldName": "470.蛊真人 (Reverend Insanity)",
      "locator": "/worldDB/469/talents/2",
      "data": {
        "name": "至尊仙胎蛊",
        "color": "SSS",
        "cost": 48000,
        "desc": "人祖传说中的蛊虫。一旦使用，你将获得至尊仙体，道痕互不排斥，可以兼修所有流派，且恢复力惊人，是魔尊幽魂的毕生杰作。",
        "type": "exclusive"
      },
      "dataSha256": "d476b66fad911df154842f0b961b1728c17b4ba82892deb3e0d5b7198680a65e",
      "sourceRef": "source.real-card",
      "stableId": "talent.gu.sovereign-body",
      "aliases": [
        "至尊仙胎蛊"
      ]
    },
    {
      "kind": "talent",
      "worldName": "470.蛊真人 (Reverend Insanity)",
      "locator": "/worldDB/469/talents/29",
      "data": {
        "name": "坚持",
        "color": "SSS",
        "cost": 10000,
        "desc": "一种精神境界。哪怕失败一万次，哪怕举世皆敌，哪怕身死道消，你也绝不放弃心中的目标。这是魔尊的潜质。",
        "type": "exclusive"
      },
