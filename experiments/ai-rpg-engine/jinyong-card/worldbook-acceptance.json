      ],
      "input": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n【金庸群侠 · 江湖人物帖】\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n【世界归属】\n单一作品线 · 射雕英雄传 → 大漠少年初入江湖\n【入局方式】\n故事初起\n【基础信息】\n姓名：沈禾\n性别：未知\n年龄：19岁\n身份：行脚商贩\n实力：不入流\n出身：大漠\n所属势力：未定\n【外貌描述】\n未填写\n【性格特质】\n未填写\n【所求之事】\n未填写\n【背景故事】\n未填写\n【开局补充】\n初到大漠集市，想找个地方歇脚。\n【通用能力】\n\n【专属武学 / 区域技艺】\n骑射本领\n\n【命数】\n未抽取\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n群侠并世，江湖未定\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
