{
  "type": "function",
  "function": {
    "name": "query_local_state",
    "description": "只读查询当前会话已登记状态；不推断未登记事实或容器归属，不修改状态。可一次查询多个范围。",
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queries"
      ],
      "properties": {
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "enum": [
                  "items",
                  "abilities",
                  "relations",
                  "balances",
                  "equipment",
                  "traits"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              }
            }
          }
        }
      }
    }
  }
}
